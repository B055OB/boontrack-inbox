# ==============================================================================
# BOONTRACK INBOX & STOREFRONT ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Petunjuk Penggunaan:
# 1. Salin file ini menjadi `.env.local` untuk development lokal.
# 2. Untuk Vercel / Railway production, pastikan seluruh variabel wajib (REQUIRED)
#    telah terkonfigurasi pada dashboard Project Settings > Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLOUDFLARE R2 OBJECT STORAGE (CRITICAL - IMAGE & MEDIA UPLOADS)
# ------------------------------------------------------------------------------
# [WAJIB] Account ID dari Cloudflare (32 karakter hexadecimal).
# Ditemukan di Cloudflare Dashboard > Overview (sidebar kanan) > Account ID.
R2_ACCOUNT_ID="56303bb13200d0980da8695adcf08550"

# [WAJIB] S3-Compatible API Endpoint untuk Cloudflare R2.
# ATURAN FORMAT MUTLAK:
#   BENAR : https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   SALAH : https://r2.cloudflarestorage.com        <- Sertifikat expired / TLS Handshake Failure 40
#   SALAH : https://assets.boontrack.com           <- Custom domain bukan S3 API endpoint
#   SALAH : https://.../boontrack-media            <- DILARANG menyertakan nama bucket di URL
R2_ENDPOINT_URL="https://56303bb13200d0980da8695adcf08550.r2.cloudflarestorage.com"
R2_ENDPOINT="https://56303bb13200d0980da8695adcf08550.r2.cloudflarestorage.com"
S3_ENDPOINT="https://56303bb13200d0980da8695adcf08550.r2.cloudflarestorage.com"

# [WAJIB] R2 Access Key ID & Secret Access Key.
# Dibuat dari Cloudflare Dashboard > R2 Object Storage > Manage R2 API Tokens (Permissions: Object Read & Write).
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"

# [WAJIB] Nama Bucket R2
R2_BUCKET_NAME="boontrack-media"

# [WAJIB] Domain publik / CDN untuk delivery gambar produk & QRIS
R2_PUBLIC_URL="https://assets.boontrack.com"
R2_PUBLIC_DOMAIN="https://assets.boontrack.com"
NEXT_PUBLIC_R2_URL="https://assets.boontrack.com"
NEXT_PUBLIC_ASSET_DOMAIN="https://assets.boontrack.com"

# ------------------------------------------------------------------------------
# 2. SUPABASE (DATABASE & STORAGE FAILOVER BACKUP)
# ------------------------------------------------------------------------------
# [WAJIB] URL instance Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# [WAJIB] Supabase Anonymous Key (untuk client-side requests)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# [WAJIB] Supabase Service Role Key (untuk backend API routes, upload failover & outbox worker)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 3. CORE BACKEND & API GATEWAY
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="https://api.boontrack.com"
NEXT_PUBLIC_API_BASE_URL="https://api.boontrack.com"
NEXT_PUBLIC_CORE_API_URL="https://api.boontrack.com"
CORE_API_URL="https://api.boontrack.com"

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (XENDIT)
# ------------------------------------------------------------------------------
XENDIT_SECRET_KEY="xnd_development_..."
XENDIT_WEBHOOK_VERIFICATION_TOKEN="your_webhook_token"
XENDIT_CALLBACK_TOKEN="your_callback_token"

# ------------------------------------------------------------------------------
# 5. WHATSAPP & BOT INTEGRATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER="6285181830080"
NEXT_PUBLIC_META_BOT_NUMBER="6285181830080"
WHATSAPP_PHONE_NUMBER_ID="1268977686299719"
WHATSAPP_WABA_ID="2039138053385393"
WHATSAPP_BOT_NUMBER="6281215567168"

# Evolution API Gateway (Railway Production)
EVOLUTION_API_URL="https://evolution-api-production-abb7.up.railway.app"
EVOLUTION_API_KEY="your_evolution_api_key"

# ------------------------------------------------------------------------------
# 6. LOGISTICS & EXPEDITION
# ------------------------------------------------------------------------------
BITESHIP_API_KEY="biteship_live.ey..."
LINCAH_API_TOKEN="your_lincah_token"
LINCAH_PARTNER_ID="your_lincah_partner_id"

# ------------------------------------------------------------------------------
# 7. AI ENGINE (GOOGLE GEMINI)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="AIzaSy..."
GOOGLE_AI_API_KEY="AIzaSy..."
AI_MODEL_NAME="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# 8. EMAIL NOTIFICATIONS (RESEND)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_..."
RESEND_FROM="Boon Pilot <pilot@boontrack.com>"
EMAIL_FROM="Boon Pilot <pilot@boontrack.com>"
RESEND_FROM_FALLBACK="Boon Pilot <onboarding@boontrack.com>"
